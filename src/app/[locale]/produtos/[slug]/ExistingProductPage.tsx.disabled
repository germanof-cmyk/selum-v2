"use client";

import { useState } from "react";
import Image from "next/image";
import Link from "next/link";
import { useParams } from "next/navigation";
import { useLocale } from "next-intl";
import { ArrowLeft, ArrowUpRight, Mail } from "lucide-react";
import Navbar from "@/components/layout/Navbar";
import Footer from "@/components/layout/Footer";
import { getCatalogProduct } from "@/lib/catalog";
import { productDetails } from "@/lib/product-detail-data";

export default function ProductPage() {
  const { slug } = useParams<{ slug: string }>();
  const locale = useLocale();
  const product = getCatalogProduct(slug);
  const details = productDetails[slug];
  const [selectedImage, setSelectedImage] = useState<string | null>(null);
  const [selectedVariant, setSelectedVariant] = useState(0);

  if (!product) {
    return (
      <main className="detail-missing">
        <p>Produto não encontrado.</p>
        <Link href={`/${locale}/produtos`}>Voltar aos produtos</Link>
      </main>
    );
  }

  const images = [product.images.hero, ...product.images.gallery];
  const activeImage = selectedImage && images.includes(selectedImage)
    ? selectedImage
    : product.images.hero;
  const activeIndex = images.indexOf(activeImage);
  const activeIsPhoto = /\.jpe?g$/i.test(activeImage);
  const hasTechnicalDetails = Boolean(details?.specs.length || details?.variants.length);

  return (
    <>
      <style>{`
        .detail-page {
          background: #f6f8fa; color: #122a40;
          min-height: 100vh; padding: 96px 0 0;
          font-family: var(--font-space), sans-serif;
        }
        .detail-shell { max-width: 1440px; margin: 0 auto; padding: 0 56px; }
        .detail-breadcrumb {
          display: flex; align-items: center; gap: 12px;
          color: #667b8d; font-size: 12px; margin: 16px 0 34px;
        }
        .detail-breadcrumb a {
          display: inline-flex; align-items: center; gap: 7px;
          color: #526e84; text-decoration: none;
        }
        .detail-breadcrumb a:hover { color: #1265aa; }
        .detail-breadcrumb-separator { width: 18px; height: 1px; background: #b7c5d0; }
        .detail-hero {
          display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
          align-items: center; gap: clamp(40px, 6vw, 100px);
          padding-bottom: 72px;
        }
        .detail-eyebrow {
          color: #1265aa; font-size: 11px; font-weight: 700;
          letter-spacing: 2px; text-transform: uppercase;
        }
        .detail-copy h1 {
          margin: 18px 0 22px; color: #0c253a;
          font-size: clamp(42px, 4.5vw, 68px); font-weight: 700;
          letter-spacing: -2.5px; line-height: 1.06;
        }
        .detail-description {
          max-width: 500px; margin: 0; color: #50687c;
          font-size: 17px; line-height: 1.75;
        }
        .detail-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
        .detail-action {
          min-height: 46px; display: inline-flex; align-items: center;
          justify-content: center; gap: 10px; padding: 0 20px;
          text-decoration: none; font-size: 13px; font-weight: 700;
          transition: transform .2s, background .2s, border-color .2s;
        }
        .detail-action:hover { transform: translateY(-2px); }
        .detail-action-primary { background: #1565c0; color: #fff; }
        .detail-action-primary:hover { background: #0d4f9c; }
        .detail-action-secondary { color: #16456a; border: 1px solid #cbd9e4; }
        .detail-action-secondary:hover { border-color: #8bb4d2; }
        .detail-media-frame {
          position: relative; aspect-ratio: 1.18; overflow: hidden;
          background: #e7edf2; border: 1px solid #e1e8ee;
        }
        .detail-media-frame img { object-fit: contain; padding: 34px; }
        .detail-media-frame img.photo { object-fit: cover; padding: 0; }
        .detail-media-count {
          position: absolute; right: 16px; bottom: 16px; z-index: 1;
          padding: 6px 9px; background: rgba(255,255,255,.9);
          color: #52687a; font-size: 11px; font-weight: 700;
        }
        .detail-thumbs { display: flex; gap: 8px; margin-top: 12px; }
        .detail-thumb {
          width: 76px; height: 66px; position: relative; overflow: hidden;
          padding: 0; background: #e7edf2; border: 2px solid transparent;
          cursor: pointer; transition: border-color .2s;
        }
        .detail-thumb:hover, .detail-thumb.active { border-color: #1565c0; }
        .detail-thumb img { object-fit: cover; }
        .detail-information { padding: 44px 0 88px; border-top: 1px solid #dde6ec; }
        .detail-information-heading { margin-bottom: 24px; }
        .detail-information-heading span {
          color: #1265aa; font-size: 11px; font-weight: 700;
          letter-spacing: 2px; text-transform: uppercase;
        }
        .detail-information-heading h2 {
          margin: 8px 0 0; color: #0c253a; font-size: 30px;
          font-weight: 700; letter-spacing: -1px;
        }
        .detail-information-grid {
          display: grid; grid-template-columns: 1.12fr .88fr;
          gap: 20px; align-items: start;
        }
        .detail-panel { padding: 30px; background: #fff; border: 1px solid #e3eaf0; }
        .detail-panel h3 { margin: 0 0 18px; color: #193e5b; font-size: 17px; font-weight: 700; }
        .detail-spec {
          display: flex; justify-content: space-between; gap: 16px;
          padding: 12px 0; border-bottom: 1px solid #edf1f4;
          font-size: 13px;
        }
        .detail-spec:last-child { border-bottom: 0; }
        .detail-spec dt { color: #73889a; }
        .detail-spec dd { margin: 0; color: #203e55; font-weight: 600; text-align: right; }
        .detail-spec dd small { margin-left: 3px; color: #6e8798; font-weight: 400; }
        .detail-variants { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
        .detail-variant {
          padding: 13px 14px; text-align: left; cursor: pointer;
          background: #f8fafb; border: 1px solid #e2eaf0;
          transition: border-color .2s, background .2s;
        }
        .detail-variant:hover, .detail-variant.active {
          border-color: #6aa4d0; background: #eff6fb;
        }
        .detail-variant strong { display: block; color: #1d4868; font-size: 14px; }
        .detail-variant span { display: block; margin-top: 5px; color: #758b9d; font-size: 11px; }
        .detail-missing { min-height: 70vh; padding: 160px 8vw; background: #f6f8fa; color: #163c5a; }
        .detail-missing a { color: #1565c0; }
        @media (max-width: 900px) {
          .detail-shell { padding: 0 28px; }
          .detail-hero { grid-template-columns: 1fr; gap: 36px; }
          .detail-copy h1 { font-size: 48px; }
          .detail-information-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 560px) {
          .detail-page { padding-top: 78px; }
          .detail-shell { padding: 0 20px; }
          .detail-breadcrumb { margin-bottom: 24px; }
          .detail-hero { padding-bottom: 46px; }
          .detail-copy h1 { font-size: 40px; letter-spacing: -1.5px; }
          .detail-description { font-size: 15px; }
          .detail-media-frame { aspect-ratio: 1; }
          .detail-information { padding-bottom: 56px; }
          .detail-panel { padding: 22px; }
        }
      `}</style>

      <Navbar />
      <main className="detail-page">
        <div className="detail-shell">
          <nav className="detail-breadcrumb" aria-label="Navegação dos produtos">
            <Link href={`/${locale}/produtos`}><ArrowLeft size={14} /> Todos os produtos</Link>
            <span className="detail-breadcrumb-separator" />
            <span>{product.name}</span>
          </nav>

          <section className="detail-hero">
            <div className="detail-copy">
              <span className="detail-eyebrow">{product.categoryLabel}</span>
              <h1>{product.name}</h1>
              <p className="detail-description">{product.description}</p>
              <div className="detail-actions">
                <a className="detail-action detail-action-primary" href="https://api.whatsapp.com/send?phone=554734401445" target="_blank" rel="noopener noreferrer">
                  Pedir orçamento <ArrowUpRight size={16} />
                </a>
                <a className="detail-action detail-action-secondary" href="mailto:contato@selum.com.br">
                  <Mail size={16} /> Falar por e-mail
                </a>
              </div>
            </div>
            <div className="detail-media">
              <div className="detail-media-frame">
                <Image
                  key={activeImage}
                  src={activeImage}
                  alt={product.name}
                  fill
                  sizes="(max-width: 900px) 100vw, 55vw"
                  className={activeIsPhoto ? "photo" : ""}
                />
                {images.length > 1 && <span className="detail-media-count">{String(activeIndex + 1).padStart(2, "0")} / {String(images.length).padStart(2, "0")}</span>}
              </div>
              {images.length > 1 && (
                <div className="detail-thumbs" aria-label={`Fotos de ${product.name}`}>
                  {images.map((image, index) => (
                    <button
                      type="button"
                      key={image}
                      className={`detail-thumb ${activeImage === image ? "active" : ""}`}
                      aria-label={`Mostrar foto ${index + 1} de ${product.name}`}
                      aria-pressed={activeImage === image}
                      onClick={() => setSelectedImage(image)}
                    >
                      <Image src={image} alt="" fill sizes="76px" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </section>

          {hasTechnicalDetails && (
            <section className="detail-information">
              <div className="detail-information-heading">
                <span>Informações do produto</span>
                <h2>Detalhes e modelos</h2>
              </div>
              <div className="detail-information-grid">
                {details?.specs.length > 0 && (
                  <div className="detail-panel">
                    <h3>Especificações</h3>
                    <dl>
                      {details.specs.map((spec) => (
                        <div className="detail-spec" key={spec.key}>
                          <dt>{spec.key}</dt>
                          <dd>{spec.val}<small>{spec.unit}</small></dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                )}
                {details?.variants.length > 0 && (
                  <div className="detail-panel">
                    <h3>Modelos disponíveis</h3>
                    <div className="detail-variants">
                      {details.variants.map((variant, index) => (
                        <button
                          type="button"
                          key={variant.name}
                          className={`detail-variant ${selectedVariant === index ? "active" : ""}`}
                          aria-pressed={selectedVariant === index}
                          onClick={() => setSelectedVariant(index)}
                        >
                          <strong>{variant.name}</strong>
                          <span>{variant.size}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </section>
          )}

        </div>
      </main>
      <Footer />
    </>
  );
}
